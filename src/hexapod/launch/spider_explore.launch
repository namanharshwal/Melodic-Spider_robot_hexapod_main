<launch>
  <!-- ==================================================================== -->
  <!-- Autonomous Mapping Launch File (SLAM + MoveBase + ExploreLite)       -->
  <!-- ==================================================================== -->

  <!-- Include SLAM and Hardware -->
  <include file="$(find hexapod)/launch/spider_real_robot_slam.launch">
    <arg name="use_rviz" value="true"/>
  </include>

  <!-- MOVE_BASE for Autonomous Path Planning -->
  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
    <param name="base_local_planner" value="base_local_planner/TrajectoryPlannerROS" />
    <rosparam file="$(find hexapod)/param/costmap_common_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find hexapod)/param/costmap_common_params.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find hexapod)/param/local_costmap_params.yaml" command="load" />
    <rosparam file="$(find hexapod)/param/global_costmap_params.yaml" command="load" />
    <rosparam file="$(find hexapod)/param/base_local_planner_params.yaml" command="load" />
    
  </node>

  <!-- FRONTIER EXPLORATION -->
  <node pkg="explore_lite" type="explore" respawn="false" name="explore" output="screen">
    <param name="robot_base_frame" value="base_link"/>
    <param name="costmap_topic" value="map"/>
    <param name="costmap_updates_topic" value="map_updates"/>
    <param name="visualize" value="true"/>
    <param name="planner_frequency" value="0.33"/>
    <param name="progress_timeout" value="30.0"/>
    <param name="potential_scale" value="3.0"/>
    <param name="orientation_scale" value="0.0"/>
    <param name="gain_scale" value="1.0"/>
    <param name="transform_tolerance" value="0.3"/>
    <param name="min_frontier_size" value="0.5"/>
  </node>

</launch>
